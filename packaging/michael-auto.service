[Unit]
Description=Michael Auto — Evidence-Driven AI Quota Orchestrator (Headless Agent Workspace Daemon)
PartOf=graphical-session.target
After=graphical-session.target dbus.service

[Service]
Type=simple
ExecStart=%h/.local/bin/michael-auto --headless
Restart=on-failure
RestartSec=5
Environment=ACCESSIBILITY_ENABLED=1
Environment=GNOME_ACCESSIBILITY=1
Environment=QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1

[Install]
WantedBy=graphical-session.target
